# syntax=docker/dockerfile:1.7
#
# Pinned BEAM wallet-api 7.5.14492 (emergency-hf6, HF6-aware at mainnet height
# 3928666). We need this daemon to answer `assets_swap_offers_list` for the
# asset-swaps subsystem — the explorer node cannot serve those (they're
# wallet-side gossip objects, not on-chain state).
#
# Policy mirror of explorer-node: pin a known-good binary, never build.
# The emergency-hf6 release ships per-distro tars (wallet-api-<distro>.tar,
# beam-wallet-<distro>.tar) instead of the older beam-<version> zip layout.
# SHA256s below are the published release-asset digests for tag emergency-hf6.
# When bumping versions, update the tag/URLs + sha256 vars and verify against
# the release page's asset digests.

FROM debian:bookworm-slim AS fetch

# wallet-api links against libssl/libcrypto and friends; the linux release
# was built on a vintage Ubuntu, so debian:bookworm just barely matches.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/beam

ARG BEAM_TAG=emergency-hf6
ARG BEAM_DISTRO=ubuntu22.04
ARG WALLET_API_URL=https://github.com/BeamMW/beam/releases/download/${BEAM_TAG}/wallet-api-${BEAM_DISTRO}.tar
ARG WALLET_CLI_URL=https://github.com/BeamMW/beam/releases/download/${BEAM_TAG}/beam-wallet-${BEAM_DISTRO}.tar
ARG WALLET_API_SHA256=b94b7f6381d569724c3dc5f177170c18895c6611fd066e4fe51484b3a65a29cb
ARG WALLET_CLI_SHA256=8b56c4448dec37cb74e30856d9b22056b894f4418e31c75b7dc927d2d8fa3696

RUN set -eux; \
    curl -fsSL "$WALLET_API_URL" -o wallet-api.tar; \
    echo "$WALLET_API_SHA256  wallet-api.tar" | sha256sum -c -; \
    curl -fsSL "$WALLET_CLI_URL" -o beam-wallet.tar; \
    echo "$WALLET_CLI_SHA256  beam-wallet.tar" | sha256sum -c -; \
    tar -xf wallet-api.tar; \
    tar -xf beam-wallet.tar; \
    chmod +x wallet-api beam-wallet; \
    rm -f *.tar *checksum.txt

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 beam

WORKDIR /opt/beam
COPY --from=fetch /opt/beam/wallet-api    /opt/beam/wallet-api
COPY --from=fetch /opt/beam/beam-wallet   /opt/beam/beam-wallet
COPY --from=fetch /opt/beam/wallet-api.cfg /opt/beam/wallet-api.cfg
COPY --from=fetch /opt/beam/beam-wallet.cfg /opt/beam/beam-wallet.cfg
COPY docker/wallet-api-entrypoint.sh /usr/local/bin/wallet-api-entrypoint.sh
# BEAM mainnet IPFS swarm key — entrypoint passes its contents via
# --ipfs_swarm_key. Public string from beam/wallet/ipfs/ipfs_imp.cpp:169.
COPY ipfs/swarm.key /opt/beam/ipfs/swarm.key
RUN chmod +x /usr/local/bin/wallet-api-entrypoint.sh \
    && mkdir -p /data && chown -R beam:beam /data /opt/beam

USER beam
WORKDIR /data
EXPOSE 10005

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/wallet-api-entrypoint.sh"]
